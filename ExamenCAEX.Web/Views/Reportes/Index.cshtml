@model ExamenCAEX.Application.DTOs.Reportes.ResumenFacturasDto

@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-4">

    <h2>Reporte de facturación</h2>

    <p class="text-muted">
        Resumen general de las facturas registradas.
    </p>

    
    <form asp-controller="Reportes"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="col-md-4">
            <label for="fechaInicio" class="form-label">
                Fecha inicial
            </label>

            <input type="date"
                   id="fechaInicio"
                   name="fechaInicio"
                   value="@ViewBag.FechaInicio"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label for="fechaFin" class="form-label">
                Fecha final
            </label>

            <input type="date"
                   id="fechaFin"
                   name="fechaFin"
                   value="@ViewBag.FechaFin"
                   class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit"
                    class="btn btn-primary">
                Filtrar
            </button>

            <a asp-controller="Reportes"
               asp-action="Index"
               class="btn btn-secondary">
                Limpiar
            </a>
        </div>

    </form>


    <a asp-controller="Reportes"
       asp-action="ExportarCsv"
       asp-route-fechaInicio="@ViewBag.FechaInicio"
       asp-route-fechaFin="@ViewBag.FechaFin"
       class="btn btn-outline-success mb-3">
        Descargar reporte CSV
    </a>

    <a asp-controller="Reportes"
       asp-action="ExportarExcel"
       asp-route-fechaInicio="@ViewBag.FechaInicio"
       asp-route-fechaFin="@ViewBag.FechaFin"
       class="btn btn-success mb-3">
        Descargar reporte Excel
    </a>


    <div class="row g-3 mt-2">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total de facturas</h6>
                    <h2>@Model.TotalFacturas</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Facturas emitidas</h6>
                    <h2 class="text-success">
                        @Model.FacturasEmitidas
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Facturas anuladas</h6>
                    <h2 class="text-danger">
                        @Model.FacturasAnuladas
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Monto vigente</h6>
                    <h2>
                        Q @Model.MontoFacturasEmitidas.ToString("N2")
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="alert alert-info mt-4">
        El monto vigente incluye únicamente facturas
        con estado EMITIDA. Las facturas anuladas
        no se incluyen en este importe.
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="card-title">
                Estado de las facturas
            </h5>

            <p class="text-muted">
                Distribución de facturas emitidas y anuladas.
            </p>

            <div style="max-width: 420px; margin: auto;">
                <canvas id="graficaFacturas"></canvas>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const emitidas = @Model.FacturasEmitidas;
            const anuladas = @Model.FacturasAnuladas;

            const canvas = document.getElementById(
                "graficaFacturas"
            );

            if (!canvas || typeof Chart === "undefined") {
                return;
            }

            new Chart(canvas, {
                type: "doughnut",
                data: {
                    labels: ["Emitidas", "Anuladas"],
                    datasets: [{
                        data: [emitidas, anuladas],
                        backgroundColor: [
                            "#198754",
                            "#dc3545"
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        });
    </script>
}
