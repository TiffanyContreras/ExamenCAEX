@model IReadOnlyList<ExamenCAEX.Application.DTOs.Productos.ProductoDto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">

    <h2>Catálogo de productos</h2>

    <a asp-controller="Productos"
       asp-action="Crear"
       class="btn btn-primary mb-3">
        + Nuevo producto
    </a>

    <p class="text-muted">
        Administración de productos registrados.
    </p>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alert alert-success" role="alert">
            @mensaje
        </div>
    }

    @if (TempData["MensajeError"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.ProductoId</td>
                        <td>@producto.Codigo</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.Descripcion</td>
                        <td>@producto.Precio.ToString("N2")</td>

                        <td>
                            @if (producto.Activo)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactivo
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-2">

                                <a asp-controller="Productos"
                                   asp-action="Editar"
                                   asp-route-id="@producto.ProductoId"
                                   class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>

                                @if (producto.Activo)
                                {
                                    <form asp-controller="Productos"
                                          asp-action="Desactivar"
                                          asp-route-id="@producto.ProductoId"
                                          method="post"
                                          onsubmit="return confirm('¿Deseas desactivar este producto?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Desactivar
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>
