@model ExamenCAEX.Web.Models.Facturas.CrearFacturaViewModel

@{
    ViewData["Title"] = "Nueva factura";
}

<div class="container mt-4">

    <h2>Nueva factura</h2>

    <p class="text-muted">
        Seleccione un cliente y los productos que desea facturar.
    </p>

    <form asp-controller="Facturas"
          asp-action="Crear"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="ClienteId"
                   class="form-label">
                Cliente
            </label>

            <select asp-for="ClienteId"
                    asp-items="Model.Clientes"
                    class="form-select">

                <option value="0">
                    -- Seleccione un cliente --
                </option>

            </select>

            <span asp-validation-for="ClienteId"
                  class="text-danger"></span>
        </div>

        <h4 class="mt-4">Productos</h4>

        
        <div class="table-responsive">
            <table class="table table-bordered" id="tablaProductos">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th style="width: 150px;">Cantidad</th>
                        <th style="width: 100px;">Acción</th>
                    </tr>
                </thead>

                <tbody id="cuerpoProductos">
                    @for (int i = 0; i < Model.Detalles.Count; i++)
                    {
                        <tr>
                            <td>
                                <select asp-for="Detalles[i].ProductoId"
                                        asp-items="Model.Productos"
                                        class="form-select producto-select">
                                    <option value="0">
                                        -- Seleccione un producto --
                                    </option>
                                </select>
                                <span asp-validation-for="Detalles[i].ProductoId"
                                      class="text-danger"></span>
                            </td>

                            <td>
                                <input asp-for="Detalles[i].Cantidad"
                                       type="number"
                                       min="1"
                                       class="form-control" />
                                <span asp-validation-for="Detalles[i].Cantidad"
                                      class="text-danger"></span>
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        onclick="eliminarProducto(this)">
                                    Quitar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="button"
                class="btn btn-outline-primary"
                onclick="agregarProducto()">
            + Agregar producto
        </button>


        <div class="mt-4">
            <button type="submit"
                    class="btn btn-success">
                Emitir factura
            </button>

            <a asp-controller="Facturas"
               asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function renumerarProductos() {
            const filas = document.querySelectorAll(
                "#cuerpoProductos tr"
            );

            filas.forEach((fila, indice) => {
                fila.querySelectorAll("[name]").forEach(campo => {
                    campo.name = campo.name.replace(
                        /Detalles\[\d+\]/,
                        `Detalles[${indice}]`
                    );
                });

                fila.querySelectorAll("[data-valmsg-for]").forEach(span => {
                    span.setAttribute(
                        "data-valmsg-for",
                        span.getAttribute("data-valmsg-for").replace(
                            /Detalles\[\d+\]/,
                            `Detalles[${indice}]`
                        )
                    );
                });
            });
        }

        function agregarProducto() {
            const cuerpo = document.getElementById(
                "cuerpoProductos"
            );

            const primeraFila = cuerpo.querySelector("tr");

            if (!primeraFila) {
                return;
            }

            const nuevaFila = primeraFila.cloneNode(true);

            nuevaFila.querySelectorAll("select").forEach(select => {
                select.value = "0";
            });

            nuevaFila.querySelectorAll("input").forEach(input => {
                input.value = "1";
            });

            nuevaFila.querySelectorAll(
                ".text-danger"
            ).forEach(span => {
                span.textContent = "";
            });

            cuerpo.appendChild(nuevaFila);

            renumerarProductos();
        }

        function eliminarProducto(boton) {
            const cuerpo = document.getElementById(
                "cuerpoProductos"
            );

            const filas = cuerpo.querySelectorAll("tr");

            if (filas.length <= 1) {
                alert("La factura debe tener al menos un producto.");
                return;
            }

            boton.closest("tr").remove();

            renumerarProductos();
        }
    </script>
}
